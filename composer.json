{
    "name": "inengine/tableui",
    "description": "A flexible table ui system for InEngine apps",
    "keywords": [
        "InEngine",
        "laravel",
        "tableui"
    ],
    "version": "1.0.4",
    "homepage": "https://github.com/inengine/tableui",
    "license": "MIT",
    "authors": [
        {
            "name": "James Johnson",
            "email": "james.johnson@excellentingenuity.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.5",
        "laravel/serializable-closure": "^2.0.10",
        "spatie/laravel-package-tools": "^1.90.0",
        "illuminate/contracts": "^12.0||^13.0",
        "illuminate/database": "^12.0||^13.0"
    },
    "require-dev": {
        "livewire/livewire": "^4.0",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^11.0.0||^10.0.0||^9.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "InEngine\\TableUI\\": "src/"
        },
        "files": [
            "src/Support/tw_merge.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "InEngine\\TableUI\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=2G",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "suggest": {
        "livewire/livewire": "Required to use the Table Livewire component (^4.0)."
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InEngine\\TableUI\\TableServiceProvider"
            ],
            "aliases": {
                "Table": "InEngine\\TableUI\\Facades\\Table"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
